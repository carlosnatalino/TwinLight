        </mxCell>
        <mxCell id="psub" value="Two hues carry the whole identity: cyan for the real network, violet for the twin. The pairing is distinguishable under the common forms of colour-vision deficiency, and both hold contrast on white and on the slate dark background." style="text;html=1;fontSize=13;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="68" width="760" height="50" as="geometry" />
