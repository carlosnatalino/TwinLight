<mxfile host="app.diagrams.net" modified="2026-07-23T12:00:00.000Z" agent="TwinLight" version="24.7.17" type="device">
  <diagram name="Concepts overview" id="concepts-overview">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="TwinLight — logo concepts" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Six directions, each built from the same idea: two things that are the same signal — one real, one simulated.&#10;Every concept is drawn from primitives (no external assets) so it can be recoloured, simplified or exported at any size.&#10;Pages: one per concept, plus a lock-up sheet and the palette." style="text;html=1;fontSize=13;fontColor=#475569;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="72" width="820" height="70" as="geometry" />
        </mxCell>

        <mxCell id="c1box" value="" style="rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c1t" value="1 · Split beam" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="60" y="172" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c1d" value="One input ray hits a prism and splits into two identical rays — the physical network and its twin. Reads instantly at 16px as a chevron. Strongest &quot;light&quot; + &quot;twin&quot; pun of the set." style="text;html=1;fontSize=12;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="196" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c1r1" value="" style="shape=mxgraph.basic.rect;fillColor=none;strokeColor=#0EA5E9;strokeWidth=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="290" width="70" height="0" as="geometry" />
        </mxCell>
        <mxCell id="c1prism" value="" style="triangle;direction=north;fillColor=none;strokeColor=#0F172A;strokeWidth=6;" vertex="1" parent="1">
          <mxGeometry x="160" y="255" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c1r2" value="" style="shape=line;strokeColor=#0EA5E9;strokeWidth=6;" vertex="1" parent="1">
          <mxGeometry x="230" y="268" width="80" height="10" as="geometry" />
        </mxCell>
        <mxCell id="c1r3" value="" style="shape=line;strokeColor=#7C3AED;strokeWidth=6;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry x="230" y="308" width="80" height="10" as="geometry" />
        </mxCell>
        <mxCell id="c1n" value="solid = real network · dashed = twin" style="text;html=1;fontSize=10;fontColor=#94A3B8;" vertex="1" parent="1">
          <mxGeometry x="90" y="345" width="260" height="20" as="geometry" />
        </mxCell>

        <mxCell id="c2box" value="" style="rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="400" y="160" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c2t" value="2 · Twin waveform" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="420" y="172" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c2d" value="Two sine waves in phase, one solid and one dashed, tracing the same path with a small divergence — the twin tracking the network, with residual error. The most literal depiction of what TwinLight measures." style="text;html=1;fontSize=12;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="420" y="196" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c2w1" value="" style="shape=mxgraph.electrical.waveforms.sine_wave;strokeColor=#0EA5E9;strokeWidth=6;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="450" y="265" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2w2" value="" style="shape=mxgraph.electrical.waveforms.sine_wave;strokeColor=#7C3AED;strokeWidth=6;fillColor=none;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry x="450" y="285" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2n" value="offset exaggerated for clarity; in the mark it is ~4% of amplitude" style="text;html=1;fontSize=10;fontColor=#94A3B8;" vertex="1" parent="1">
          <mxGeometry x="450" y="345" width="280" height="20" as="geometry" />
        </mxCell>

        <mxCell id="c3box" value="" style="rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="760" y="160" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c3t" value="3 · Constellation / eye" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="780" y="172" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c3d" value="A QPSK constellation whose four clusters double into eight — a twinned constellation. Immediately legible to the optical-communications audience; the abstract shape still works for everyone else." style="text;html=1;fontSize=12;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="780" y="196" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c3ax1" value="" style="shape=line;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="850" y="290" width="140" height="10" as="geometry" />
        </mxCell>
        <mxCell id="c3ax2" value="" style="shape=line;direction=north;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="915" y="225" width="10" height="140" as="geometry" />
