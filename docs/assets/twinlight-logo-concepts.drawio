        <mxCell id="c5box" value="" style="rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="400" y="410" width="340" height="230" as="geometry" />
