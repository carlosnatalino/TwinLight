        <mxCell id="c5t" value="5 · Double-L monogram" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="420" y="422" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c5d" value="Two interlocking &quot;L&quot; strokes forming a square aperture — the negative space reads as a lens or a fiber cross-section. Pure typography-adjacent geometry: scales to a favicon better than any of the others." style="text;html=1;fontSize=12;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="420" y="446" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c5s1" value="" style="shape=mxgraph.basic.l_shape;fillColor=#0EA5E9;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="500" y="510" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c5s2" value="" style="shape=mxgraph.basic.l_shape;direction=south;fillColor=#7C3AED;strokeColor=none;opacity=80;" vertex="1" parent="1">
          <mxGeometry x="560" y="510" width="90" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c5n" value="overlap multiplies to a deeper tone — one colour when printed in mono" style="text;html=1;fontSize=10;fontColor=#94A3B8;" vertex="1" parent="1">
          <mxGeometry x="450" y="608" width="290" height="20" as="geometry" />
        </mxCell>

        <mxCell id="c6box" value="" style="rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="760" y="410" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c6t" value="6 · Spectrum slots" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="780" y="422" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c6d" value="A row of flexi-grid spectrum slots, some allocated, mirrored top and bottom. Directly depicts the RMSA side of the project. Most &quot;insider&quot; of the six — great for a conference slide, weaker as a standalone mark." style="text;html=1;fontSize=12;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="780" y="446" width="300" height="60" as="geometry" />
