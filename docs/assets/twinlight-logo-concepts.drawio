        <mxCell id="rec" value="Recommendation&#10;&#10;Concept 1 (Split beam) is the strongest primary mark: it survives being shrunk to a favicon, it carries both halves of the name, and it does not depend on the viewer knowing optical communications. Concept 3 (Constellation) makes an excellent secondary mark for talks and papers aimed at the photonics community. Concept 5 (Double-L) is the fallback if a purely geometric, text-free monogram is preferred.&#10;&#10;The shipped README mark (docs/assets/twinlight-logo.svg) implements Concept 1." style="rounded=1;arcSize=6;fillColor=#EFF6FF;strokeColor=#0EA5E9;align=left;verticalAlign=top;spacingLeft=16;spacingTop=10;spacingRight=16;whiteSpace=wrap;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="665" width="1060" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Primary mark — construction" id="primary-mark">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="pmtitle" value="Primary mark — Split beam, construction grid" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#0F172A;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="pmsub" value="Drawn on a 24×24 grid. The incoming ray enters on the vertical centre line; the prism apex sits at the grid centre; the two output rays leave at ±18°. Solid ray = the physical network, dashed ray = the twin." style="text;html=1;fontSize=13;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="68" width="740" height="50" as="geometry" />
        </mxCell>

        <mxCell id="grid" value="" style="rounded=0;fillColor=none;strokeColor=#E2E8F0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="480" height="480" as="geometry" />
        </mxCell>
        <mxCell id="gx" value="" style="shape=line;strokeColor=#F1F5F9;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="375" width="480" height="10" as="geometry" />
        </mxCell>
        <mxCell id="gy" value="" style="shape=line;direction=north;strokeColor=#F1F5F9;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="295" y="140" width="10" height="480" as="geometry" />
        </mxCell>

        <mxCell id="pmin" value="" style="shape=line;strokeColor=#0EA5E9;strokeWidth=22;strokeCap=round;" vertex="1" parent="1">
          <mxGeometry x="90" y="375" width="150" height="10" as="geometry" />
        </mxCell>
        <mxCell id="pmprism" value="" style="triangle;direction=north;fillColor=none;strokeColor=#0F172A;strokeWidth=22;" vertex="1" parent="1">
          <mxGeometry x="240" y="300" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="pmout1" style="edgeStyle=none;strokeColor=#0EA5E9;strokeWidth=22;endArrow=none;rounded=0;strokeCap=round;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="345" as="sourcePoint" />
            <mxPoint x="520" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="pmout2" style="edgeStyle=none;strokeColor=#7C3AED;strokeWidth=22;endArrow=none;rounded=0;strokeCap=round;dashed=1;dashPattern=1 1.4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="415" as="sourcePoint" />
            <mxPoint x="520" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="scaletitle" value="Scale test" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="600" y="140" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="scalenote" value="Export the mark at 512, 128, 32 and 16 px and check that the two output rays stay distinguishable. Below ~20 px, drop the dash pattern and differentiate the rays by colour alone." style="text;html=1;fontSize=12;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="600" y="166" width="330" height="60" as="geometry" />
        </mxCell>

        <mxCell id="clearspace" value="Clear space&#10;&#10;Keep free space equal to the height of the prism on all four sides. Never place the mark on a busy photographic background — the dashed ray disappears." style="rounded=1;arcSize=6;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;whiteSpace=wrap;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="600" y="250" width="330" height="120" as="geometry" />
        </mxCell>

        <mxCell id="donts" value="Do not&#10;&#10;· Recolour the two output rays to the same hue — the twin relationship is the whole idea.&#10;· Add a gradient to the prism; it must survive one-colour printing.&#10;· Rotate the mark. The horizontal input ray establishes reading direction.&#10;· Stretch non-uniformly. The ±18° output angle is fixed." style="rounded=1;arcSize=6;fillColor=#FEF2F2;strokeColor=#FCA5A5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;whiteSpace=wrap;fontSize=12;fontColor=#7F1D1D;" vertex="1" parent="1">
          <mxGeometry x="600" y="390" width="330" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Lock-ups" id="lockups">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="lutitle" value="Lock-ups" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#0F172A;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="600" height="34" as="geometry" />
