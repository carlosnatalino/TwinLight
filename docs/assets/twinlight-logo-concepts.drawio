          <mxGeometry x="40" y="410" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c4t" value="4 · Mirrored node pair" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="60" y="422" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c4d" value="A small network graph and its mirror image across a horizontal axis, the reflection drawn lighter. Says &quot;network&quot; and &quot;twin&quot; without saying &quot;optics&quot; — the safest choice if the project ever broadens beyond optical." style="text;html=1;fontSize=12;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="446" width="300" height="60" as="geometry" />
        </mxCell>
